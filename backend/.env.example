# ==============================================================================
# MOVANA BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your local private credentials.
# NEVER commit .env to version control!
#
# MANDATORY SAFETY CONSTRAINTS:
# 1. DATABASE_NAME must strictly be 'movana'. Any other database will fail startup.
# 2. DATABASE_USER must strictly be 'movana_app'. The superuser 'postgres' and
#    owner 'movana_owner' are forbidden at application runtime.
# ==============================================================================

# Application & Runtime
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
LOG_LEVEL=log
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# Authoritative PostgreSQL Database (Target: movana | Role: movana_app)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=movana
DATABASE_USER=movana_app
DATABASE_PASSWORD=replace_with_your_actual_movana_app_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Redis Cache & Ephemeral Store (Optional for local development / liveness)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REQUIRED_FOR_READY=false

# Test Configuration (Optional - for gated database integration tests)
RUN_DB_INTEGRATION_TESTS=false
