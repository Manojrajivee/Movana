# ==============================================================================
# MOVANA PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure local secret values.
# NEVER commit .env to version control!

# Environment
NODE_ENV=development
APP_PORT=3000
APP_NAME=Movana

# PostgreSQL Database Configuration (Target: movana)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movana
DB_USER=movana_app
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_TIMEOUT_MS=30000

# Administrative / Migration Connection (Used ONLY by migration runners)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your_admin_password_here

# Redis Cache & Ephemeral Real-Time Store (Location feeds & session cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Security Secrets
JWT_SECRET=replace_with_64_byte_cryptographic_secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

# Payment Provider Gateway Secrets (Stripe / Razorpay / etc.)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
